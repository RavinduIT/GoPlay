# GoPlay Sports Platform Environment Configuration

# Application Settings
APP_NAME="GoPlay Sports Platform"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=goplay_sports_platform
DB_USERNAME=root
DB_PASSWORD=

# Test Database
DB_TEST_HOST=localhost
DB_TEST_PORT=3306
DB_TEST_DATABASE=goplay_test
DB_TEST_USERNAME=root
DB_TEST_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRY=3600

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Payment Gateway (Stripe)
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key-here
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@goplay.lk
MAIL_FROM_NAME="GoPlay Sports Platform"

# SMS Configuration (Optional)
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM_NUMBER=

# File Storage
STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

# Cache Configuration
CACHE_DRIVER=file
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Session Configuration
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Queue Configuration
QUEUE_CONNECTION=sync

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=
FACEBOOK_PIXEL_ID=

# Social Login (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Business Settings
TAX_RATE=0.084
SERVICE_FEE_RATE=0.05
BOOKING_ADVANCE_DAYS=30
MAX_BOOKING_DURATION=8
CANCELLATION_HOURS=24

# Security Settings
CORS_ALLOWED_ORIGINS="http://localhost,http://127.0.0.1"
RATE_LIMIT_PER_HOUR=1000
ENABLE_API_RATE_LIMITING=true

# Development Settings (Development Only)
APP_LOG_LEVEL=debug
DB_LOG_QUERIES=false
ENABLE_QUERY_LOG=false