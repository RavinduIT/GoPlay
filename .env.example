# ============================================================
# GoPlay Sports Platform - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Application
APP_NAME=GoPlay
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=goplay_sports_platform
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Email (SMTP via Gmail example)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@goplay.lk
MAIL_FROM_NAME=GoPlay

# Admin
ADMIN_EMAIL=admin@goplay.lk
