{
  "name": "goplay-sports-platform",
  "version": "1.0.0",
  "description": "Professional sports facility booking and coaching platform",
  "main": "public/index.php",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "start": "webpack-dev-server --mode development",
    "test": "jest",
    "lint": "eslint resources/js/**/*.js",
    "lint:fix": "eslint resources/js/**/*.js --fix",
    "format": "prettier --write resources/js/**/*.js resources/css/**/*.css",
    "serve": "php -S localhost:8000 -t public",
    "db:migrate": "php artisan migrate",
    "db:seed": "php artisan seed",
    "cache:clear": "php artisan cache:clear"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/goplay-sports-platform.git"
  },
  "keywords": [
    "sports",
    "booking",
    "coaching",
    "facility",
    "mvc",
    "php",
    "javascript"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "babel-loader": "^9.1.0",
    "css-loader": "^6.8.0",
    "eslint": "^8.43.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^29.5.0",
    "mini-css-extract-plugin": "^2.7.0",
    "prettier": "^2.8.0",
    "sass": "^1.63.0",
    "sass-loader": "^13.3.0",
    "style-loader": "^3.3.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "chart.js": "^4.3.0",
    "leaflet": "^1.9.0",
    "swiper": "^9.4.0",
    "moment": "^2.29.0",
    "bootstrap": "^5.3.0",
    "font-awesome": "^4.7.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}